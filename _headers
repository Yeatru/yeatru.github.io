# =====================================================
# Cloudflare Pages 头配置 - 消除 PSI 「Use efficient cache lifetimes」
# 文档: https://developers.cloudflare.com/pages/configuration/headers/
# 规则: 每个路径模式独占一行, 头部指令用两个空格缩进
# =====================================================

# --- 通用安全头 (对所有路径) ---
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# --- 图片: 缓存 1 个月 (产品图/banner 基本不变) ---
/Images/*.jpg
  Cache-Control: public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=604800

/Images/*.jpeg
  Cache-Control: public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=604800

/Images/*.png
  Cache-Control: public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=604800

/Images/*.webp
  Cache-Control: public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=604800

/Images/*.svg
  Cache-Control: public, max-age=2592000, s-maxage=2592000, immutable

/Images/*.gif
  Cache-Control: public, max-age=2592000, s-maxage=2592000, stale-while-revalidate=604800

# --- Logo SVG: 1 年 (不变) ---
/logo.svg
  Cache-Control: public, max-age=31536000, immutable

# --- CSS/JS/字体: 永久缓存 (文件名含 hash, 变更即更新) ---
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.mjs
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# --- 静态资源目录 ---
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# --- 结构化数据 & LLM 文件: 缓存 24 小时 ---
/*.json
  Cache-Control: public, max-age=86400

/*.txt
  Cache-Control: public, max-age=86400

# --- HTML 页面: 缓存 1 小时, 必须重新校验 ---
/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large

# data.html 显式强制 index (消除 GSC "Excluded by noindex tag" 误报缓存)
/data.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1
  X-Content-Type-Options: nosniff

/
  Cache-Control: public, max-age=3600, must-revalidate

# --- Sitemap: 缓存 1 天 ---
/sitemap.xml
  Cache-Control: public, max-age=86400
